# The Go API's gRPC address, and whether to dial it without TLS.
GRPC_API_SERVER_URL=localhost:50051
GRPC_INSECURE=true

# 32 random bytes, base64-encoded, for the session cookie. Generate with:
#   openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=

# Optional cookie name; defaults to fijo_owner_session.
COOKIE_NAME=fijo_owner_session
